#-----------------------------------------------------------------------------
# File name : sim_exp.tcl
# Description : Vivado-side helper to launch one AXI experiment with a fixed
#   waveform layout, using the same mechanism as the DemoStd project:
#   the .wcfg is a real simulation source file of fileset sim_1, so Vivado
#   itself adds "-view <wcfg>" to the xsim command line.  (Vivado drops -view
#   when it is put into xsim.simulate.xsim.more_options.)
#
# Usage (Vivado Tcl console, once per session):
#   source d:/code/SystemVerilog/axi4_ddr3_imp/sim_exp.tcl
#   sim_exp 4
#
# sim_exp <n> does three things:
#   1) copies wave/exp<n>.wcfg over the project wave config axi_wave.wcfg
#   2) makes sure axi_wave.wcfg is registered in fileset sim_1
#   3) sets -testplusarg EXP=<n>, closes the old session, relaunches
#
# ASCII only.
#-----------------------------------------------------------------------------

proc sim_exp_has_wcfg {wcfg_proj} {
    set want [file normalize $wcfg_proj]
    foreach f [get_files -of_objects [get_filesets sim_1]] {
        if {[string equal -nocase [file normalize $f] $want]} {
            return 1
        }
    }
    return 0
}

proc sim_exp_register_wcfg {wcfg_proj} {
    if {[sim_exp_has_wcfg $wcfg_proj]} {
        puts "sim_exp: wave config already in project"
        return 1
    }
    if {[catch {add_files -fileset sim_1 -norecurse $wcfg_proj} msg]} {
        puts "sim_exp: ERROR add_files failed: $msg"
        return 0
    }
    if {![sim_exp_has_wcfg $wcfg_proj]} {
        puts "sim_exp: ERROR could not register $wcfg_proj"
        return 0
    }
    puts "sim_exp: registered $wcfg_proj into fileset sim_1"
    return 1
}

proc sim_exp_check_view {bat wcfg_proj} {
    if {![file exists $bat]} {
        puts "sim_exp: WARNING simulate.bat not found: $bat"
        return
    }
    set fh [open $bat r]
    set txt [read $fh]
    close $fh
    if {[string first "-view" $txt] >= 0} {
        puts "sim_exp: OK - simulate.bat contains -view"
    } else {
        puts "sim_exp: WARNING - simulate.bat has no -view, wave config not loaded."
        puts "sim_exp: open $wcfg_proj once in the Wave window and save it,"
        puts "sim_exp: or check that it is listed under Simulation Sources."
    }
}

proc sim_exp {{n 1}} {
    if {![string is integer -strict $n] || $n < 1 || $n > 6} {
        puts "sim_exp: EXP must be an integer in 1..6"
        return
    }

    set root      {d:/code/SystemVerilog/axi4_ddr3_imp}
    set wavetcl   $root/wave_axi_exp.tcl
    set wcfg_src  $root/wave/exp$n.wcfg
    set wcfg_proj $root/axi4_ddr3_imp.srcs/sim_1/new/axi_wave.wcfg

    if {![file exists $wcfg_src]} {
        puts "sim_exp: ERROR waveform config not found: $wcfg_src"
        return
    }
    if {![file exists $wavetcl]} {
        puts "sim_exp: ERROR run script not found: $wavetcl"
        return
    }

    catch {close_sim}

    if {![sim_exp_register_wcfg $wcfg_proj]} {
        return
    }

    file copy -force $wcfg_src $wcfg_proj
    puts "sim_exp: wave config <- $wcfg_src"

    set fs [get_filesets sim_1]

    set_property -name {xsim.simulate.runtime}          -value {all}     -objects $fs
    set_property -name {xsim.simulate.log_all_signals}  -value {true}    -objects $fs
    set_property -name {xsim.simulate.custom_tcl}       -value $wavetcl  -objects $fs
    # plusarg is not usable here (xsim splits "EXP=n" at '='), so the
    # experiment id is written into exp_cfg.svh before launch.
    set_property -name {xsim.simulate.xsim.more_options} -value {} -objects $fs

    set cfg_new $root/axi4_ddr3_imp.srcs/sim_1/new/exp_cfg.svh
    set cfg_imp $root/axi4_ddr3_imp.srcs/sim_1/imports/new/exp_cfg.svh
    set fh [open $cfg_new w]
    puts $fh "// exp_cfg.svh - generated by sim_exp.tcl"
    puts $fh "`ifndef AXI_EXP_CFG_SVH"
    puts $fh "`define AXI_EXP_CFG_SVH"
    puts $fh "`define AXI_EXP_ID $n"
    puts $fh "`endif"
    close $fh
    file copy -force $cfg_new $cfg_imp
    puts "sim_exp: EXP id $n -> exp_cfg.svh"

    catch {reset_run sim_1}

    launch_simulation

    set bat $root/axi4_ddr3_imp.sim/sim_1/behav/xsim/simulate.bat
    after 3000 [list sim_exp_check_view $bat $wcfg_proj]

    puts "sim_exp: launched EXP=$n"
    puts "sim_exp: waveform window should show only the groups of exp$n"
}

puts "sim_exp.tcl loaded. Run: sim_exp <1..6>"
